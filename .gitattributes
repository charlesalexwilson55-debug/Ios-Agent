# Authored on Windows, built on a macOS runner.
#
# Without this, git checks files out with CRLF endings on Windows and commits
# them that way, and `bash scripts/build-ios.sh` on the runner dies with
# "$'\r': command not found" on the first line. Forcing LF for everything text
# avoids that and keeps the Swift and Python sources consistent too.
* text=auto eol=lf

*.sh           text eol=lf
*.swift        text eol=lf
*.py           text eol=lf
*.yml          text eol=lf
*.yaml         text eol=lf
*.json         text eol=lf
*.md           text eol=lf
*.plist        text eol=lf
*.entitlements text eol=lf
*.xcprivacy    text eol=lf

*.png  binary
*.jpg  binary
*.ipa  binary
*.safetensors binary
*.gguf binary
